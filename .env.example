# Auth.js (NextAuth v5) — required in production
# Generate with:  openssl rand -base64 32
AUTH_SECRET=

# Google OAuth — required to enable "Continue with Google"
# 1) https://console.cloud.google.com/apis/credentials → Create OAuth Client ID
# 2) Web application, authorized redirect URIs:
#    http://localhost:3000/api/auth/callback/google
#    https://<your-vercel-domain>/api/auth/callback/google
# 3) Copy the Client ID + Secret here
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Google Gemini — used by the ⌘K palette + inline AI actions (V0.5)
# https://aistudio.google.com/apikey
GEMINI_API_KEY=
